generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  MBWAY
  BANK_TRANSFER
  CASH // pagamento em mão, só com levantamento
  MULTIBANCO // referência Multibanco (IfthenPay)
  CARD       // cartão de crédito/débito (IfthenPay Gateway)
  APPLE_PAY  // Apple Pay (IfthenPay Gateway)
  GOOGLE_PAY // Google Pay (IfthenPay Gateway)
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  firstName String?
  lastName  String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders  Order[]
  address Address?
}

model Address {
  id         String  @id @default(cuid())
  userId     String  @unique
  street     String
  city       String
  postalCode String
  country    String  @default("PT")

  user User @relation(fields: [userId], references: [id])
}

model Category {
  id       String    @id @default(cuid())
  name     String
  nameEn   String?
  slug     String    @unique
  visible  Boolean   @default(true)
  products Product[]
}

model Product {
  id            String   @id @default(cuid())
  name          String
  nameEn        String?
  slug          String   @unique
  description   String?
  descriptionEn String?
  color         String?  // cor (PT), ex.: "Branco/Preto" — feed Google Merchant
  colorEn       String?
  groupId       String?  // agrupa as cores do mesmo produto (item_group_id)
  price         Float
  images      String[]
  stock       Int      @default(0)
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  ebookFile   String?  // caminho para o PDF (apenas para produtos da categoria Ebooks)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String?
  category   Category?   @relation(fields: [categoryId], references: [id])
  variants   Variant[]
  orderItems OrderItem[]

  giftPromotionTriggers GiftPromotionTrigger[]
  giftPromotionGifts    GiftPromotionGift[]
}

model Variant {
  id        String  @id @default(cuid())
  productId String
  size      String?
  color     String?
  stock     Int     @default(0)

  product Product @relation(fields: [productId], references: [id])
}

model Order {
  id          String        @id @default(cuid())
  userId      String?
  status      OrderStatus   @default(PENDING)
  totalAmount Float
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Dados do comprador (pode ser guest)
  email       String
  firstName   String
  lastName    String
  phone       String

  // Morada de entrega
  street      String
  city        String
  postalCode  String
  country     String        @default("PT")

  // Fatura
  wantsInvoice Boolean      @default(false)
  nif          String?
  companyName  String?

  // Batch Logistics
  batchOrderNumber String?
  shippingMethod   String?
  shippingCost     Float    @default(0)

  // Código de desconto aplicado (snapshot do código e do valor descontado)
  discountCode   String?
  discountAmount Float    @default(0)

  // Notas escritas pelo cliente no checkout
  notes String?

  user       User?         @relation(fields: [userId], references: [id])
  items      OrderItem[]
  payment    Payment?
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String  // snapshot do nome na altura da compra
  price     Float   // snapshot do preço na altura da compra
  quantity  Int
  size      String?
  isGift    Boolean @default(false) // oferta de uma promoção (preço 0)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique
  method        PaymentMethod
  status        String        @default("PENDING") // PENDING, CONFIRMED, FAILED
  reference     String?       // referência para o cliente
  // IfthenPay: identificador enviado como orderId (único), pedido e dados Multibanco
  providerRef   String?       @unique
  requestId     String?
  entity        String?
  expiresAt     DateTime?
  confirmedAt   DateTime?
  createdAt     DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

enum DiscountType {
  PERCENTAGE // value = percentagem (ex.: 10 = 10%)
  FIXED      // value = euros
}

model DiscountCode {
  id             String       @id @default(cuid())
  code           String       @unique // guardado sempre em maiúsculas
  description    String?
  type           DiscountType @default(PERCENTAGE)
  value          Float
  active         Boolean      @default(true)
  minOrderAmount Float?       // subtotal mínimo dos produtos
  maxUses        Int?         // null = ilimitado
  usedCount      Int          @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Settings {
  id    String @id @default("singleton")
  key   String @unique
  value String
}

// Oferta automática: por cada `requiredUnits` unidades dos produtos gatilho, o cliente
// escolhe `giftsPerGroup` produtos de oferta, até `maxGiftsPerOrder` por encomenda.
// Só pode haver uma promoção ativa em cada período (validado no serviço).
model GiftPromotion {
  id               String   @id @default(cuid())
  name             String
  active           Boolean  @default(true)
  startsAt         DateTime
  endsAt           DateTime
  requiredUnits    Int      @default(2)
  giftsPerGroup    Int      @default(1)
  maxGiftsPerOrder Int      @default(3)
  messagePt        String?  // texto mostrado ao cliente no carrinho/checkout
  messageEn        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  triggers GiftPromotionTrigger[]
  gifts    GiftPromotionGift[]
}

model GiftPromotionTrigger {
  promotionId String
  productId   String
  units       Int    @default(1) // ex.: um pack com 2 bolas conta 2

  promotion GiftPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
}

model GiftPromotionGift {
  promotionId String
  productId   String

  promotion GiftPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
}
