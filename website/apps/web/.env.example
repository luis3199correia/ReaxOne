NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Só no servidor (lido em runtime): URL da API na rede interna, ex: http://api:3001/api.
# Vazio → usa NEXT_PUBLIC_API_URL. Necessário se o servidor web não alcança o domínio público.
API_INTERNAL_URL=

# "true" ativa a landing "Working Out" — só admins logados veem o site completo
NEXT_PUBLIC_COMING_SOON=false

# Número de WhatsApp de contacto, formato internacional sem espaços nem "+" (ex: 351911084422)
NEXT_PUBLIC_WHATSAPP_NUMBER=351911084422
